DATABASE_URL="postgresql://wordapp:wordapp@localhost:5432/wordapp?schema=public"

JWT_ACCESS_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_EXPIRES_IN="7d"
GOOGLE_OAUTH_CLIENT_IDS=""
REFRESH_TOKEN_HASH_SECRET="change_me"

BCRYPT_SALT_ROUNDS="10"
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_URL="mobile://reset-password"
MOBILE_APP_SCHEME="mobile"
PASSWORD_RESET_EMAIL_PROVIDER="console"
PASSWORD_RESET_EMAIL_FROM="Word App <security@example.com>"
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_URL="mobile://verify-email"
EMAIL_VERIFICATION_EMAIL_PROVIDER="console"
EMAIL_VERIFICATION_EMAIL_FROM="Word App <security@example.com>"
RESEND_API_KEY="re_change_me"
RESEND_REQUEST_TIMEOUT_MS=10000

# Keep 0 for direct connections. Behind a trusted reverse proxy, set the
# trusted hop count or Express trust-proxy value so IP rate limits use client IPs.
TRUST_PROXY=0

PORT=4000

# Set to 0 to disable the in-process scheduled review notification scanner.
SCHEDULED_REVIEW_NOTIFICATION_SCAN_INTERVAL_MS=60000
